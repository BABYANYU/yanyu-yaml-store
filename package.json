{
  "private": true,
  "name": "yanyu-yaml-store",
  "version": "1.0.0",
  "description": "Yanyu YAML Store maintained by BABYANYU",
  "repository": "https://github.com/BABYANYU/yanyu-yaml-store",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "predeploy": "npm test && npm run build",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --var BASE_URL:http://localhost:8787 --port 8787",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "delete-paste": "wrangler kv key delete --binding PB --remote",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "author": "BABYANYU, based on pastebin-worker by Sharzy L",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.2",
    "@vitest/coverage-istanbul": "4.1.12",
    "eslint": "^8.33.0",
    "prettier": "^2.8.3",
    "vitest": "4.1.12",
    "wrangler": "4.163.0"
  },
  "dependencies": {
    "mdast-util-to-string": "4.0.0",
    "mime": "^3.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "vfile-message": "^4.0.2"
  }
}
